# Copy to .env (repo root for docker/just, apps/api/.env when running on the host).

REDIS_URL=redis://localhost:6379/0

# Optional: sicap.ai key for the SEAP scraper.
SICAP_API_KEY=

# Optional: a chat model for the agent stages, as a langchain "provider:model"
# string. Empty = no model is ever called; every stage uses its rule-based version.
# The worker is the process that needs this.
#
# Local, no key, nothing leaves the machine (what the project runs on now):
#   1. ollama serve  &&  ollama pull qwen2.5
#   2. cd apps/api && uv sync --extra ollama
#   3. LLM_MODEL=ollama:qwen2.5
# A cloud model instead:
#   uv sync --extra anthropic ; LLM_MODEL=anthropic:claude-opus-5-5 ; ANTHROPIC_API_KEY=...
LLM_MODEL=
ANTHROPIC_API_KEY=
# Where Ollama listens, if not http://localhost:11434 (from docker: http://host.docker.internal:11434).
LLM_BASE_URL=
# Context window asked of a local model; articles are cut to fit it.
LLM_CONTEXT_TOKENS=8192
# Articles a local model reads per search, and the seconds it may spend on one
# search in all (what it has not read by then waits for a later search).
LLM_LOCAL_MAX_SOURCES=4
LLM_LOCAL_BUDGET_SECONDS=480
# Cost ceiling per search: how many articles the model reads, and how much of each.
LLM_MAX_SOURCES=8
LLM_MAX_SOURCE_CHARS=20000
# Only if the provider's default structured-output method fails for your model,
# e.g. "json_schema".
LLM_STRUCTURED_METHOD=

# People may send their own model and API key with a search (Settings in the
# dashboard). Turn off on a server you do not want used that way.
ALLOW_USER_LLM=true

# After a company search, also search its top administrator (one level deep).
AUTO_FOLLOW_OFFICER=true

# The local trade-register index, built with `just onrc-import`.
ONRC_DB=data/onrc.sqlite
