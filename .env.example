# Copy to .env (repo root for docker/just, apps/api/.env when running on the host).

REDIS_URL=redis://localhost:6379/0

# Optional: sicap.ai key for the SEAP scraper.
SICAP_API_KEY=

# Optional: langchain model string ("provider:model") for the agent nodes.
# Leave empty to skip them. Needs the provider package, e.g. `uv add langchain-anthropic`.
LLM_MODEL=
